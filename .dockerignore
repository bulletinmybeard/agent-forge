# VCS + project meta
.git/
.gitignore
.github/
.dockerignore
.prettierrc
.prettierignore
.gitleaks.toml

# Python caches / envs / build artifacts
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.ruff_cache/
.mypy_cache/
.pytest_cache/
poetry.lock

# Node
node_modules/

# Secrets + local config (bind-mounted at runtime, never baked into the image)
config.yaml
*-config.yaml
secrets/
deploy.env
deploy.local.env

# Private agent / routing overlays (bind-mounted at runtime when needed)
custom_agents.local.yaml
custom_agents.yaml
tool_routing.local.yaml
user_context.md

# Runtime data + bind-mounted dirs (provided at runtime, not at build)
data/
profiles/

# Not used by any Dockerfile (entire scripts/ tree — no LaunchAgent helpers
# or deploy scripts baked into images)
docs/
sandbox/
scripts/

# OS / editor
.DS_Store
.idea/
.vscode/
